# CallTrust Engine Environment Configuration
# Copy to .env and fill in values

# ─── General ──────────────────────────────────────────
APP_NAME=CallTrust Engine
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ─── Backend ──────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# ─── WebSocket ────────────────────────────────────────
WS_URL=ws://localhost:8000/ws/analyze
WS_PING_INTERVAL=30
WS_MAX_CONNECTIONS=100

# ─── Frontend ─────────────────────────────────────────
VITE_WS_URL=ws://localhost:8000/ws/analyze
VITE_API_URL=http://localhost:8000
VITE_APP_MODE=demo

# ─── Database ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=calltrust
POSTGRES_USER=calltrust
POSTGRES_PASSWORD=changeme_in_production

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ─── ML Models ────────────────────────────────────────
MODEL_DIR=./ml/checkpoints
MOCK_INFERENCE=true
RAWNET2_ONNX_PATH=
AASIST_ONNX_PATH=
SSL_CLASSIFIER_ONNX_PATH=
CHANNEL_DETECTOR_ONNX_PATH=
SPEAKER_ENCODER_ONNX_PATH=

# ─── Audio Pipeline ──────────────────────────────────
SAMPLE_RATE=16000
WINDOW_SIZE_SEC=3.0
WINDOW_STRIDE_SEC=1.0
VAD_THRESHOLD=0.3
UPDATE_INTERVAL_MS=500

# ─── Trust Score Thresholds ───────────────────────────
THRESHOLD_SAFE=75
THRESHOLD_CAUTION=50
THRESHOLD_HIGH_RISK=25

# ─── Privacy ──────────────────────────────────────────
PRIVACY_MODE=strict
PERSIST_RAW_AUDIO=false
AUDIT_LOG_ENABLED=true
SESSION_TTL_MINUTES=60

# ─── Prometheus ───────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ─── Security ─────────────────────────────────────────
SECRET_KEY=changeme_in_production_use_openssl_rand
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
